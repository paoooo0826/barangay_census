{
  "name": "barangay-census",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-ocr.cjs && vite",
    "build": "node scripts/prepare-ocr.cjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node scripts/harden-braces.cjs",
    "test": "node scripts/verify-regressions.cjs && node scripts/verify-followup-fixes.cjs && node scripts/verify-ui-behavior.cjs && node scripts/verify-feature-additions.cjs && node scripts/verify-presentation-fixes.cjs && node scripts/verify-enhancements.cjs && node scripts/verify-media-terms.cjs && node scripts/verify-brims.cjs && node scripts/verify-id-document.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.6",
    "@tesseract.js-data/eng": "1.0.0",
    "face-api.js": "^0.22.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.3",
    "esbuild": "0.28.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "30.1.2",
    "postcss": "^8.5.19",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "allowScripts": {
    "core-js@3.49.0": true
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "node-fetch": "2.7.0",
    "baseline-browser-mapping": "2.11.0",
    "browserslist": "4.29.3",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6"
  }
}
